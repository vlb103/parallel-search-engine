@startuml deployment
!include style.iuml
skinparam nodesep 50
skinparam ranksep 70

node "Комп'ютер користувача" {
  artifact "Браузер (Web UI)" as Browser
  artifact "CLI ./search" as Cli

  node "Docker Compose (мережа default)" {
    node "контейнер server\n(debian:bookworm-slim)" as ServerNode {
      artifact "search_server\n:8080" as App
      artifact "web/index.html" as Page
    }
    node "контейнер dataset\n(python:3.12-slim)" as DatasetNode {
      artifact "prepare_dataset.py" as Prepare
    }
    node "контейнер ollama\n(ollama/ollama)" as OllamaNode {
      artifact "ollama serve\n:11434" as OllamaApp
    }
    database "том dataset\n(статті Wikipedia)" as DataVolume
    database "том ollama\n(модель llama3.2:1b)" as ModelVolume
  }
}

cloud "Hugging Face\nwikimedia/wikipedia" as HuggingFace

Browser --> ServerNode : HTTP, WebSocket\nlocalhost:8080
Cli --> ServerNode : HTTP\nlocalhost:8080
ServerNode --> OllamaNode : HTTP\nollama:11434
ServerNode ..> DataVolume : /data\n(лише читання)
DatasetNode ..> DataVolume : /data
OllamaNode ..> ModelVolume : /root/.ollama
DatasetNode --> HuggingFace : HTTPS\n(перший запуск)
@enduml
