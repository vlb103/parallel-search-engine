@startuml class
!include style.iuml
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 60
hide empty members

class Server {
  - engine_ : SearchEngine*
  - ollama_ : OllamaClient*
  - port_ : int
  - thread_count_ : size_t
  - index_page_ : string
  + Server(engine, ollama, port, thread_count)
  + Run() : void
  - HandleClient(fd : int) : void
  - HandleHealth(fd : int) : void
  - HandleIndex(fd : int, request : HttpRequest) : void
  - HandleSearch(fd : int, request : HttpRequest) : void
  - HandleStats(fd : int) : void
  - HandleWebSocket(fd : int, request : HttpRequest) : void
}

class HttpRequest <<struct>> {
  + method : string
  + path : string
  + headers : map<string, string>
  + body : string
}

class Http <<utility>> {
  + SendAll(fd, data, size) : bool
  + RecvAll(fd, data, size) : bool
  + ReadRequest(fd) : optional<HttpRequest>
  + SendResponse(fd, status, content_type, body) : void
}

class WebSocket <<utility>> {
  + WsHandshake(fd, request : HttpRequest) : bool
  + WsReadText(fd) : optional<string>
  + WsSendText(fd, message : string) : bool
}

class OllamaClient <<thread-safe>> {
  - host_ : string
  - port_ : int
  - model_ : string
  - generate_mutex_ : mutex
  + OllamaClient(host, port, model)
  + IsAvailable() : bool
  + Expand(query : string) : vector<string>
  - Request(method, path, body) : optional<string>
}

class SearchEngine <<thread-safe>> {
  - data_dir_ : string
  - index_ : ConcurrentIndex
  - documents_mutex_ : shared_mutex
  - documents_ : vector<string>
  - build_mutex_ : mutex
  - documents_indexed_ : atomic<size_t>
  - build_time_ms_ : atomic<int64_t>
  - threads_used_ : atomic<size_t>
  + SearchEngine(data_dir : string)
  + BuildIndex(threads : size_t) : optional<IndexStats>
  + Search(terms : vector<string>) : vector<SearchResult>
  + Stats() : IndexStats
  - IndexDocument(doc_id : uint32_t) : void
  - MakeSnippet(doc_id : string, terms : vector<string>) : string
}

class SearchResult <<struct>> {
  + doc_id : string
  + score : double
  + snippet : string
}

class IndexStats <<struct>> {
  + documents : size_t
  + build_time_ms : int64_t
  + threads_used : size_t
}

class Tokenizer <<utility>> {
  + Tokenize(text : string_view) : vector<string>
}

class ThreadPool <<thread-safe>> {
  - mutex_ : mutex
  - has_work_ : condition_variable
  {field} - tasks_ : queue<function<void()>>
  - stopping_ : bool
  - workers_ : vector<thread>
  + ThreadPool(thread_count : size_t)
  + Submit(task : function<void()>) : void
  + Shutdown() : void
  - WorkerLoop() : void
}

class ConcurrentIndex <<thread-safe>> {
  - segments_ : vector<Segment>
  - initial_buckets_ : size_t
  + ConcurrentIndex(segment_count = 64, initial_buckets = 1024)
  + Add(term : string, posting : Posting) : void
  + Find(term : string) : vector<Posting>
  + Clear() : void
  + Size() : size_t
  - {static} Hash(term : string) : size_t
  - Rehash(segment : Segment*) : void
  - BucketOf(segment : Segment, hash : size_t) : size_t
}

class Segment <<struct>> {
  + mutex : shared_mutex
  + buckets : vector<unique_ptr<Node>>
  + term_count : size_t
}

class Node <<struct>> {
  + term : string
  + hash : size_t
  + postings : vector<Posting>
  + next : unique_ptr<Node>
}

class Posting <<struct>> {
  + doc_id : uint32_t
  + tf : uint32_t
}

Server o--> "1" SearchEngine
Server o--> "1" OllamaClient
Server ..> ThreadPool : пул клієнтів
Server ..> Http
Server ..> WebSocket
Http ..> HttpRequest
WebSocket ..> Http

SearchEngine *-- "1" ConcurrentIndex
SearchEngine ..> ThreadPool : пул індексації
SearchEngine ..> Tokenizer
SearchEngine ..> SearchResult
SearchEngine ..> IndexStats

ConcurrentIndex *-- "64" Segment
Segment *-- "*" Node
Node *-- "*" Posting
Node --> "0..1" Node : next

OllamaClient ..> Http
OllamaClient ..> Tokenizer

note right of ConcurrentIndex
  shared_mutex на сегмент:
  Add – ексклюзивний,
  Find – спільний замок
end note

note left of ThreadPool
  mutex + condition_variable
  захищають чергу задач
end note

note right of OllamaClient
  generate_mutex_: один
  запит до LLM за раз
end note
@enduml
