' Спільний стиль для всіх діаграм.
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam ArrowThickness 1.2
skinparam actor {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
  RoundCorner 16
  FontSize 15
  FontStyle bold
}
skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  HeaderBackgroundColor #BBDEFB
  StereotypeFontColor #546E7A
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}
skinparam node {
  BackgroundColor #F5F5F5
  BorderColor #607D8B
}
skinparam artifact {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam folder {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam sequence {
  ParticipantBackgroundColor #E3F2FD
  ParticipantBorderColor #1565C0
  LifeLineBorderColor #90A4AE
  LifeLineBackgroundColor #BBDEFB
  BoxBackgroundColor #FAFAFA
  BoxBorderColor #90A4AE
  GroupBorderColor #78909C
  GroupBackgroundColor #ECEFF1
  ReferenceBackgroundColor #FAFAFA
}
skinparam participant {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam control {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam collections {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
